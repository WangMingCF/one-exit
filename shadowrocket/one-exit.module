#!name=AI Exit - 固定家宽
#!desc=常用海外 AI、验证服务与出口检测走 固定家宽；节点备注必须完全一致。
[Rule]
# 节点小宝服务直连，覆盖所有子域名
DOMAIN-SUFFIX,iepose.com,DIRECT
DOMAIN-SUFFIX,ionewu.com,DIRECT
# NAS 设备别名直连
DOMAIN,synology.link,DIRECT
DOMAIN,kwrt.link,DIRECT
DOMAIN,openwrt.link,DIRECT
# Claude / Anthropic
DOMAIN-SUFFIX,claude.ai,固定家宽
DOMAIN-SUFFIX,claude.com,固定家宽
DOMAIN-SUFFIX,clau.de,固定家宽
DOMAIN-SUFFIX,anthropic.com,固定家宽
DOMAIN-SUFFIX,claudeusercontent.com,固定家宽
DOMAIN-SUFFIX,modelcontextprotocol.io,固定家宽
IP-CIDR,160.79.104.0/21,固定家宽,no-resolve
IP-CIDR6,2607:6bc0::/48,固定家宽,no-resolve
# OpenAI / ChatGPT / Codex
DOMAIN-SUFFIX,openai.com,固定家宽
DOMAIN-SUFFIX,chatgpt.com,固定家宽
DOMAIN-SUFFIX,oaistatic.com,固定家宽
DOMAIN-SUFFIX,oaiusercontent.com,固定家宽
DOMAIN-SUFFIX,oaistatsig.com,固定家宽
DOMAIN-SUFFIX,openaimerge.com,固定家宽
# Google / Gemini / AI Studio；google.com 等规则也会覆盖非 AI 的 Google 服务。
DOMAIN-SUFFIX,google.com,固定家宽
DOMAIN-SUFFIX,googleapis.com,固定家宽
DOMAIN-SUFFIX,gstatic.com,固定家宽
DOMAIN-SUFFIX,gmail.com,固定家宽
DOMAIN-SUFFIX,googleusercontent.com,固定家宽
DOMAIN-SUFFIX,google.dev,固定家宽
DOMAIN-SUFFIX,recaptcha.net,固定家宽
# Grok / Perplexity / Poe / Meta AI / Character AI
DOMAIN-SUFFIX,grok.com,固定家宽
DOMAIN-SUFFIX,x.ai,固定家宽
DOMAIN-SUFFIX,grokusercontent.com,固定家宽
DOMAIN-SUFFIX,perplexity.ai,固定家宽
DOMAIN-SUFFIX,poe.com,固定家宽
DOMAIN-SUFFIX,meta.ai,固定家宽
DOMAIN-SUFFIX,character.ai,固定家宽
# Microsoft Copilot：身份验证主机是共享服务，会影响其他微软账号登录。
DOMAIN,copilot.microsoft.com,固定家宽
DOMAIN-SUFFIX,copilot.cloud.microsoft,固定家宽
DOMAIN,login.microsoftonline.com,固定家宽
# GitHub Copilot：github.com 同时承载普通 GitHub 登录与浏览。
DOMAIN-SUFFIX,githubcopilot.com,固定家宽
DOMAIN,copilot-proxy.githubusercontent.com,固定家宽
DOMAIN,origin-tracker.githubusercontent.com,固定家宽
DOMAIN,github.com,固定家宽
DOMAIN,api.github.com,固定家宽
DOMAIN,github.githubassets.com,固定家宽
# 其他 AI 聊天、模型平台及开发工具
